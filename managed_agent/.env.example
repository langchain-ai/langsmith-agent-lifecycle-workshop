# Copy to .env (gitignored). `mda dev` reads it; `mda deploy` forwards every
# non-reserved value below as a hosted deployment secret.

# Required: authenticates `mda dev` / `mda deploy` and the Agent Server API.
# Reserved: it is never uploaded to the deployment.
LANGSMITH_API_KEY=""

# ---------------------------------------------------------------------------
# Model credentials: choose ONE option. model.py picks the model strings from
# what is set (see model.py).
# ---------------------------------------------------------------------------

# Option A: your own provider key(s).
#   OpenAI only    -> gpt-5.4 (specialists gpt-5.4-mini)
#   Anthropic only -> claude-sonnet-5-5 (specialists claude-haiku-4-5)
#   Both           -> gpt-5.4, with Claude Sonnet 5.5 as the cross-provider fallback
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# Option B: LangSmith LLM Gateway (no provider key here). Leave Option A unset.
#   Models become "langsmith:openai/gpt-5.4" etc. A workspace admin must add the
#   provider secrets (OPENAI_API_KEY, and ANTHROPIC_API_KEY for Claude) under
#   Settings > Integrations > Provider secrets, otherwise: 424 "Required workspace
#   secret ... is missing". The key needs the gateway:invoke permission.
#   Use a LangSmith key here: LANGSMITH_API_KEY is never forwarded to the deployment.
#   It must be WORKSPACE-scoped (org-scoped keys aren't supported for the Gateway), and
#   that workspace must hold the provider secrets above. LANGSMITH_API_KEY_GATEWAY and
#   LC_GATEWAY_KEY are accepted as aliases (model.py copies them into this variable).
# LANGSMITH_GATEWAY_API_KEY=""

# Optional: choose the main model explicitly, e.g. "anthropic:claude-sonnet-5-5"
# (Option A) or "langsmith:anthropic/claude-sonnet-5-5" (Option B).
# DEEP_AGENT_MODEL=""

# Optional: the specialists' model. Default: the small model on the same route as
# the main one (gpt-5.4-mini, or claude-haiku-4-5 for Anthropic).
# DEEP_AGENT_SMALL_MODEL=""

# Optional: the first fallback model. Default: the other provider's model, as a
# direct key if set, else through the Gateway when Option B is in use, else none.
# DEEP_AGENT_FALLBACK_MODEL=""
