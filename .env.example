# ============================================================================
# WORKSHOP CONFIGURATION
# ============================================================================

# Default model for all agents in the workshop
# Examples: "anthropic:claude-haiku-4-5", "openai:gpt-5.4", "openai:gpt-5.4-mini"
# Can be overridden per-agent in factory functions
WORKSHOP_MODEL="anthropic:claude-haiku-4-5"

# Model for the advanced modules (Module 4 Deep Agents 201 and the Module 6 comparisons).
# Credentials come from the options below: your own provider key(s), or the LangSmith
# LLM Gateway (LANGSMITH_GATEWAY="true"). Default: openai:gpt-5.4, or
# anthropic:claude-sonnet-5-5 when ANTHROPIC_API_KEY is the only key set.
# DEEP_AGENT_MODEL="openai:gpt-5.4"   # or "anthropic:claude-sonnet-5-5"
# Smaller model for subagents and the fallback model. Default: openai:gpt-5.4-mini
# (anthropic:claude-haiku-4-5 when DEEP_AGENT_MODEL is Anthropic).
# DEEP_AGENT_SMALL_MODEL="openai:gpt-5.4-mini"
# First fallback model if the main model keeps failing (cross-provider, so an OpenAI
# outage is covered). Default: anthropic:claude-sonnet-5-5 (openai:gpt-5.4 when
# DEEP_AGENT_MODEL is Anthropic). Skipped unless that provider's key is available
# or LANGSMITH_GATEWAY is on.
# DEEP_AGENT_FALLBACK_MODEL="anthropic:claude-sonnet-5-5"

# Jev decision model (Module 4 Section 3) via the LangSmith LLM Gateway. Uses
# LANGSMITH_API_KEY; that key's workspace needs a TYPESAFE_API_KEY provider secret
# (Settings > Integrations > Provider secrets), otherwise: 424 Failed Dependency.
# If the secret lives in a different workspace than your key's default one, set its ID:
# JEV_WORKSPACE_ID=""
# Pinned by default (typesafe/jev-1.14.0): thresholds don't transfer between versions.
# JEV_MODEL="typesafe/jev-1.14.0"

# Embedding provider for document vectorstore
# Options: "huggingface" (default, local model, no API key) or "openai" (requires OPENAI_API_KEY)
# Note: Changing providers requires rebuilding the vectorstore:
#   uv run python data/data_generation/build_vectorstore.py
# EMBEDDING_PROVIDER="huggingface"

# ============================================================================
# LANGSMITH CONFIGURATION
# ============================================================================

# Optional for LangSmith tracing and experiment tracking
LANGSMITH_TRACING="true"
LANGSMITH_PROJECT="langsmith-agent-lifecycle-workshop"
LANGSMITH_API_KEY="<langsmith-api-key>"
LANGSMITH_ENDPOINT="<langsmith-endpoint>" # defaults to https://api.smith.langchain.com if using cloud

# ============================================================================
# MODEL PROVIDER API KEYS
# ============================================================================

# If using OpenAI
OPENAI_API_KEY="<openai-api-key>"
OPENAI_BASE_URL="<openai-base-url>" # Optional, if different from the default

# If using Azure OpenAI
AZURE_OPENAI_API_KEY="<azure-openai-api-key>"
AZURE_OPENAI_ENDPOINT="<azure-openai-endpoint>"
AZURE_OPENAI_API_VERSION=""

# If using Anthropic
ANTHROPIC_API_KEY="<anthropic-api-key>"

# If using AWS
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION_NAME=""
AWS_MODEL_ARN=""

# ----------------------------------------------------------------------------
# Alternative: LangSmith LLM Gateway (instead of direct provider keys above)
# ----------------------------------------------------------------------------
# If your org has the LLM Gateway enabled, you can route chat model calls
# through it instead of storing raw provider keys locally. Requires a
# LangSmith workspace-scoped API key with the `gateway:invoke` permission,
# and langchain-anthropic>=1.5.1 / langchain-openai>=1.4.1 (already the repo
# minimums). This replaces the ANTHROPIC_API_KEY / OPENAI_API_KEY lines above
# for chat models - set only ONE of the two setups, not both:
#
#   LANGSMITH_GATEWAY="true"
#   LANGSMITH_GATEWAY_API_KEY="<langsmith-api-key-with-gateway-invoke>"
#
# LANGSMITH_API_KEY_GATEWAY and LC_GATEWAY_KEY are accepted as aliases for
# LANGSMITH_GATEWAY_API_KEY. On a machine where IT provisions the Gateway in a file
# that only interactive shells load, point at it instead (no keys in this .env):
#
#   GATEWAY_ENV_FILE="/etc/lc_internal/gateway_env"   # LangChain-managed Macs
#
# Check whichever setup you chose with: uv run python verify_setup.py
#
# The Gateway key must be WORKSPACE-scoped (organization-scoped keys aren't supported;
# a personal access token uses its default workspace), and that workspace must hold the
# provider secrets. Chat-model calls can't be pointed at another workspace, so a key whose
# workspace has no OPENAI_API_KEY secret gets a 424. See
# https://docs.langchain.com/langsmith/llm-gateway-authentication#use-a-workspace-scoped-key
#
# Note: this only covers chat models, not embeddings. If EMBEDDING_PROVIDER
# is "openai", you still need the separate OpenAI gateway setup below.
#
# See: https://docs.langchain.com/langsmith/llm-gateway-quickstart

# ----------------------------------------------------------------------------
# Alternative: OpenAI embeddings through the LLM Gateway
# ----------------------------------------------------------------------------
# Only needed if EMBEDDING_PROVIDER=openai above. Embeddings aren't covered
# by LANGSMITH_GATEWAY, so this replaces the OPENAI_API_KEY line above:
#
#   OPENAI_API_KEY="<langsmith-api-key-with-gateway-invoke>"
#   OPENAI_BASE_URL="https://gateway.smith.langchain.com/openai/v1"

# ============================================================================
# DEPLOYMENT CONFIGURATION (Optional)
# ============================================================================

# LangGraph deployment URL for simulation system
# Only needed if running automated simulations against deployed graphs
# Example: "https://your-deployment.us.langgraph.app"
LANGGRAPH_DEPLOYMENT_URL=""

# Module 6: Agent Server URL printed by `mda deploy` for managed_agent/.
# The notebooks call MDA_DEPLOYMENT_URL; point it at your deployment, or
# http://127.0.0.1:2040 for `mda dev`.
# Example: "https://techhub-support-xxxx.us.langgraph.app"
MDA_DEPLOYMENT_URL=""
